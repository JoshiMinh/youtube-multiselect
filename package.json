    "test:browser": "node tests/runtime.mjs && node tests/options.mjs && node tests/libraries.mjs && node tests/hardening.mjs && node tests/ui.mjs",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "~6.0.3",
    "vite": "8.3.5",
    "wxt": "^0.21.5"
  }
}
