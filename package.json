{
  "name": "youtube-multiselect",
  "private": true,
  "version": "1.7.2",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
